{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".emit",
    "allowJs": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "bin/**/*.mts",
    "scripts/**/*.mts",
    "studio/**/*.mts",
    "studio/web/**/*.ts",
    "test/**/*.mts",
    "benchmarks/**/*.mts"
  ],
  "exclude": ["node_modules", ".emit"]
}
